{
  "schemaVersion": "1.1",
  "status": "SECRET_CONTRACT_PREPARED_NOT_APPLIED",
  "domain": "codestra-marketing-platform",
  "environments": ["staging", "production-read-only-canary"],
  "secretClasses": [
    "service-client-credentials",
    "database-credentials",
    "meta-test-read-token",
    "social-runtime-read-token",
    "smtp-test-credentials",
    "observability-mtls-material"
  ],
  "rules": {
    "gitStoredSecrets": false,
    "dynamicOrRotatablePreferred": true,
    "leastPrivilege": true,
    "environmentIsolation": true,
    "humanApprovalForProductionReadOnlyCanary": true,
    "productionWriteProviderCredentialsAllowed": false
  },
  "bindings": [
    {"consumer":"marketing","environment":"staging","classes":["database-credentials","service-client-credentials","meta-test-read-token"],"paths":["codestra/staging/database/marketing","codestra/staging/keycloak/service-clients","codestra/staging/providers/meta/read-only"],"capabilities":["read"]},
    {"consumer":"ai","environment":"staging","classes":["database-credentials","service-client-credentials"],"paths":["codestra/staging/database/ai","codestra/staging/keycloak/service-clients"],"capabilities":["read"]},
    {"consumer":"communication","environment":"staging","classes":["database-credentials","service-client-credentials","smtp-test-credentials"],"paths":["codestra/staging/database/communication","codestra/staging/keycloak/service-clients"],"capabilities":["read"]},
    {"consumer":"social-control","environment":"staging","classes":["database-credentials","service-client-credentials","social-runtime-read-token"],"paths":["codestra/staging/database/social","codestra/staging/keycloak/service-clients","codestra/staging/providers/social-runtime/read-only"],"capabilities":["read"]},
    {"consumer":"social-runtime","environment":"staging","classes":["service-client-credentials"],"paths":["codestra/staging/keycloak/service-clients"],"capabilities":["read"]},
    {"consumer":"middleware","environment":"staging","classes":["database-credentials","service-client-credentials"],"paths":["codestra/staging/database/middleware","codestra/staging/keycloak/service-clients"],"capabilities":["read"]},
    {"consumer":"odoo","environment":"staging","classes":["database-credentials","service-client-credentials"],"paths":["codestra/staging/database/odoo","codestra/staging/keycloak/service-clients"],"capabilities":["read"]},
    {"consumer":"n8n","environment":"staging","classes":["service-client-credentials"],"paths":["codestra/staging/n8n/runtime","codestra/staging/n8n/middleware-client"],"capabilities":["read"]},
    {"consumer":"keycloak","environment":"staging","classes":["service-client-credentials"],"paths":["codestra/staging/keycloak/operator","codestra/staging/keycloak/service-clients"],"capabilities":["read"]},
    {"consumer":"kong","environment":"staging","classes":["service-client-credentials"],"paths":["codestra/staging/kong/operator","codestra/staging/kong/upstreams"],"capabilities":["read"]},
    {"consumer":"telemetry","environment":"staging","classes":["observability-mtls-material"],"paths":["codestra/staging/observability/otel"],"capabilities":["read"]},
    {"consumer":"alloy","environment":"staging","classes":["observability-mtls-material"],"paths":["codestra/staging/observability/otel"],"capabilities":["read"]},
    {"consumer":"marketing","environment":"production-read-only-canary","classes":["meta-test-read-token"],"paths":["codestra/production-read-only-canary/providers/meta/read-only"],"capabilities":["read"]},
    {"consumer":"social-control","environment":"production-read-only-canary","classes":["social-runtime-read-token"],"paths":["codestra/production-read-only-canary/providers/social-runtime/read-only"],"capabilities":["read"]},
    {"consumer":"telemetry","environment":"production-read-only-canary","classes":["observability-mtls-material"],"paths":["codestra/production-read-only-canary/observability/otel"],"capabilities":["read"]},
    {"consumer":"alloy","environment":"production-read-only-canary","classes":["observability-mtls-material"],"paths":["codestra/production-read-only-canary/observability/otel"],"capabilities":["read"]}
  ],
  "activation": {
    "policiesApplied": false,
    "secretsIssued": false,
    "productionWriteSecretsIssued": false
  }
}
