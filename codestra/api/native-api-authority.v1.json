{
  "schemaVersion": 1,
  "status": "SOURCE_MAPPED_RUNTIME_UNVERIFIED",
  "contract": "codestra/api/service-contract.v1.json",
  "runtimeApplyAuthorized": false,
  "controlPlaneProxyAllowed": false,
  "secretValueReadbackEnabled": false,
  "callerClasses": {
    "control-plane-readback": {
      "description": "Codestra-Telemetry control plane. Observes health and readiness HTTP status only; every response body is discarded and no other operation may be proxied.",
      "authentication": "private mTLS client certificate",
      "authority": "codestra/api/service-contract.v1.json#managementReadback"
    },
    "workload": {
      "description": "Keycloak JWT service identities generated from config/workload-secret-authority.v1.json. Read-only access to one environment namespace plus token self-management.",
      "authentication": "auth/jwt-codestra CEL role with bound audience openbao and a five-minute JWT lifetime",
      "authority": "config/workload-secret-authority.v1.json"
    },
    "service-runtime": {
      "description": "Corporate observability runtimes (Grafana, Loki, Tempo, OpenTelemetry, Superset) that hold dynamic leases under the runtime-v1 overlay.",
      "authentication": "auth/jwt-codestra runtime roles under codestra/runtime-v1",
      "authority": "codestra/runtime-v1/desired-state.json"
    },
    "operator": {
      "description": "Human secrets-operator and secrets-admin roles authenticated through Keycloak OIDC with MFA, scoped to one business and one environment.",
      "authentication": "auth/oidc with client openbao-secrets, PKCE S256 and MFA",
      "authority": "codestra/runtime-v1/oidc-plan.v1.json"
    },
    "auditor": {
      "description": "Human security auditors with read-only system introspection and no secret, credential or mutation capability.",
      "authentication": "auth/oidc with the auditor policy",
      "authority": "codestra/runtime-v1/policies/auditor.hcl"
    },
    "platform-security": {
      "description": "Protected release, custody and recovery ceremonies executed by the platform-security owner through reviewed scripts and protected-environment workflows only.",
      "authentication": "bootstrap or ceremony token that is revoked after use; never a workload identity",
      "authority": "REPO_AUTHORITY.md"
    }
  },
  "mounts": {
    "sys": {
      "type": "system",
      "source": "upstream"
    },
    "auth/token": {
      "type": "token",
      "source": "upstream"
    },
    "auth/jwt-codestra": {
      "type": "jwt",
      "source": "config/auth/keycloak-jwt.v1.json",
      "status": "PREPARED_DISABLED"
    },
    "auth/oidc": {
      "type": "oidc",
      "source": "codestra/runtime-v1/oidc-plan.v1.json",
      "status": "CONTROL_PLANE_PREPARED_NOT_APPLIED"
    },
    "codestra": {
      "type": "kv-v2",
      "source": "config/secrets/engines.v1.json",
      "status": "PREPARED_DISABLED"
    },
    "database": {
      "type": "database",
      "source": "config/secrets/engines.v1.json",
      "status": "PREPARED_DISABLED",
      "enabledByDefault": false
    },
    "pki-codestra": {
      "type": "pki",
      "source": "config/secrets/engines.v1.json",
      "status": "PREPARED_DISABLED",
      "enabledByDefault": false
    },
    "transit-codestra": {
      "type": "transit",
      "source": "config/secrets/engines.v1.json",
      "status": "PREPARED_DISABLED",
      "enabledByDefault": false
    }
  },
