{
  "schemaVersion": "1.0",
  "status": "CONTROL_PLANE_PREPARED_NOT_APPLIED",
  "domain": "unified-intake",
  "secretPathPattern": "kv-<business>/data/intake/<application>/<environment>/*",
  "workloads": {
    "intake-bff": {"allowedSecretDomains": ["oidc-client", "captcha-verification", "webhook-hmac", "internal-tls"], "browserSecretExposure": false, "tokenTtlMinutes": 15, "tokenMaxTtlMinutes": 60},
    "middleware-intake": {"allowedSecretDomains": ["odoo-adapter", "redis-acl", "provider-webhook-hmac", "internal-tls"], "crossBusinessRead": false, "tokenTtlMinutes": 15, "tokenMaxTtlMinutes": 60},
    "odoo-intake-adapter": {"allowedSecretDomains": ["odoo-service-credential", "internal-tls"], "writeScope": "approved CRM upsert only", "tokenTtlMinutes": 15, "tokenMaxTtlMinutes": 60}
  },
  "pki": {"rolePattern": "intake-<business>-<application>-<environment>", "maximumLeafTtlHours": 24, "allowAnyName": false, "privateKeyExportDefault": false},
  "forbiddenStorage": ["form responses", "survey responses", "survey answers", "contact records", "consent payloads", "messages", "transcripts", "customer financial payloads"],
  "boundaries": {"browserSecretAccess": false, "crossBusinessWildcardPolicy": false, "observabilityReadsSecretValues": false, "supersetReadsSecretValues": false, "beyvraTradeSigningAuthority": false, "communicationsDeliveryAuthority": false},
  "rotation": {"oidcClientSecret": "90d-or-provider-minimum", "webhookHmac": "dual-version-rotation", "serviceCertificates": "24h-maximum", "redisAclPassword": "30d-or-dynamic-credential"},
  "activation": {"mountsCreated": false, "policiesApplied": false, "jwtRolesConfigured": false, "pkiRolesConfigured": false, "crossBusinessDenyTestPassed": false, "productionApproved": false}
}
