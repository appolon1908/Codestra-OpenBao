{
  "schemaVersion": "1.1",
  "status": "CONTROL_PLANE_PREPARED_NOT_APPLIED",
  "businesses": [
    "codestra",
    "moneybee",
    "beyvra",
    "breero",
    "larim-a",
    "transportation",
    "booked4seasons",
    "social",
    "klyrow",
    "telnexa",
    "kyqra",
    "restaurant",
    "provisioning"
  ],
  "platformProducts": [
    "loki",
    "prometheus",
    "grafana",
    "tempo",
    "opentelemetry",
    "alloy",
    "node-exporter",
    "cadvisor",
    "redis-exporter",
    "blackbox-exporter",
    "superset",
    "openbao"
  ],
  "mountPlan": {
    "kvPlatform": "kv-platform/",
    "kvV2PerBusiness": "kv-<business>/",
    "transitSharedPlatform": "transit-platform/",
    "transitDedicatedBeyvra": "transit-beyvra/",
    "database": "database/",
    "pkiIntermediate": "pki-platform-intermediate/",
    "pkiIssuing": "pki-platform-issuing/",
    "system": ["sys/audit", "sys/health", "sys/storage/raft"]
  },
  "humanRoles": {
    "openbao-security-admin": {
      "mfa": true,
      "defaultTtlMinutes": 15,
      "maximumTtlMinutes": 60,
      "capabilities": "approved-system-administration-without-daily-root"
    },
    "openbao-auditor": {
      "mfa": true,
      "secretValueRead": false,
      "capabilities": "audit-health-policy-and-mount-metadata-read"
    },
    "platform-product-secrets-admin": {
      "mfa": true,
      "scope": "kv-platform-only",
      "businessSecretValueRead": false,
      "systemMountAdministration": false
    },
    "business-<business>-secrets-admin": {
      "mfa": true,
      "scope": "single-business-mount",
      "crossBusiness": false,
      "systemMountAdministration": false
    },
    "business-<business>-secrets-read": {
      "mfa": true,
      "scope": "single-business-approved-prefixes",
      "write": false,
      "crossBusiness": false
    }
  },
  "platformWorkloadRoleTemplate": {
    "name": "platform-<product>-<environment>",
    "authMethod": "jwt",
    "requiredAudience": "openbao",
    "boundClaims": {
      "codestra_business": "platform",
      "application": "<product>",
      "environment": "<environment>"
    },
    "tokenType": "service",
    "tokenTtlMinutes": 15,
    "tokenMaximumTtlMinutes": 60,
    "renewable": true,
    "periodicWithoutMaximum": false,
    "secretPath": "kv-platform/data/<domain>/<product>/*",
    "businessMountRead": false,
    "mountAdministration": false
  },
  "businessWorkloadRoleTemplate": {
    "name": "workload-<business>-<application>-<environment>",
    "authMethod": "jwt",
    "requiredAudience": "openbao",
    "boundClaims": {
      "codestra_business": "<business>",
      "application": "<application>",
      "environment": "<environment>"
    },
    "tokenType": "service",
    "tokenTtlMinutes": 15,
    "tokenMaximumTtlMinutes": 60,
    "renewable": true,
    "periodicWithoutMaximum": false,
    "policies": ["workload-<business>-<application>-<environment>"],
    "secretPath": "kv-<business>/data/<application>/<environment>/*",
    "databaseRolePattern": "<business>-<application>-<environment>-readonly-or-service",
    "pkiRolePattern": "<business>-<application>-<environment>"
  },
  "policyRules": {
    "defaultPolicy": "deny",
    "wildcardAcrossBusinessMounts": false,
    "platformPoliciesMayReadBusinessMounts": false,
    "policyNameFromCustomerInput": false,
    "mountAdministrationForWorkloads": false,
    "sysRawAccessForWorkloads": false,
    "tokenCreationForWorkloads": false,
    "identityMutationForWorkloads": false,
    "auditDisableForNonBreakGlass": false,
    "secretDeletionRequiresBusinessAdmin": true,
    "metadataDestroyRequiresDualApproval": true
  },
  "secretDomainCatalogue": {
    "database": {
      "dynamicPreferred": true,
      "staticFallbackRequiresRotationSla": true
    },
    "redis": {
      "scopedAclRequired": true,
      "passwordFileDeliveryPreferred": true
    },
    "oauth": {
      "clientSecretRotationRequired": true,
      "browserExposure": false
    },
    "object-storage": {
      "perProductCredential": true,
      "sharedPortfolioCredential": false,
      "dynamicCredentialPreferredWhereSupported": true
    },
    "provider-api": {
      "perProviderPerApplication": true,
      "sharedPortfolioCredential": false
    },
    "smtp": {
      "directApplicationUseRequiresApprovedMailerBoundary": true
    },
    "webhook-hmac": {
      "perEndpointOrProvider": true,
      "dualActiveVersionRotationSupported": true
    },
    "tls-pki": {
      "issueFromApprovedRoleOnly": true,
      "privateKeyExportDefault": false
    },
    "deployment": {
      "immutableReleaseIdentityNotSecret": true,
      "registryCredentialsShortLivedWhereSupported": true
    }
  },
  "pkiRoles": {
    "serviceRolePattern": "<business-or-platform>-<application>-<environment>",
    "allowedDomainsFromDeploymentAuthority": true,
    "allowSubdomainsOnlyWhenApproved": true,
    "allowAnyName": false,
    "allowIpSansDefault": false,
    "serverFlag": true,
    "clientFlag": true,
    "keyType": "ec",
    "keyBits": 256,
    "ttlHours": 24,
    "maxTtlHours": 168,
    "generateLease": true,
    "noStore": true
  },
  "databaseRoles": {
    "readOnly": {
      "defaultTtlMinutes": 15,
      "maximumTtlMinutes": 60,
      "statementAuthority": "database-owned-reviewed-template",
      "writePrivileges": false
    },
    "applicationService": {
      "defaultTtlMinutes": 15,
      "maximumTtlMinutes": 60,
      "statementAuthority": "application-database-owner-reviewed-template",
      "superuser": false,
      "crossDatabase": false
    }
  },
  "rotationAndRevocation": {
    "leaseRevocationOnDeploymentRetirement": true,
    "rotateOnOperatorDeparture": true,
    "rotateOnSuspectedExposure": true,
    "rotateBeforeProviderExpiry": true,
    "dualVersionWindowForWebhooks": true,
    "orphanTokensProhibited": true,
    "batchTokensForLongRunningServices": false,
    "rotationFailureMetric": "codestra_openbao_rotation_failures_total",
    "leaseExpiryMetric": "codestra_openbao_lease_expiry_seconds",
    "auditDeliveryFailureAlert": true
  },
  "beyvra": {
    "mount": "kv-beyvra/",
    "transitMount": "transit-beyvra/",
    "secretPrefixes": [
      "market-data/",
      "provider-connectivity/",
      "broker-exchange-custody/",
      "reconciliation/"
    ],
    "brokerExchangeCustodyPrefixDefaultEnabled": false,
    "approvedWorkloads": ["beyvra-backend", "beyvra-execution-worker"],
    "generalAnalyticsAccess": false,
    "observabilityAccess": false,
    "n8nAccess": false,
    "exportableSigningKeys": false,
    "dualApproval": true
  },
  "releaseGates": {
    "oidcDiscoveryVerified": false,
    "oidcRoleMappingVerified": false,
    "jwtAudienceAndClaimsVerified": false,
    "platformMountVerified": false,
    "businessMountsVerified": false,
    "platformToBusinessDenialTestPassed": false,
    "crossBusinessPolicyTestsPassed": false,
    "workloadTokenTtlVerified": false,
    "auditDevicesVerified": false,
    "auditRemoteCopyVerified": false,
    "pkiRoleConstraintsVerified": false,
    "databaseRevocationVerified": false,
    "rotationRunbooksTested": false,
    "breakGlassExercisePassed": false,
    "raftSnapshotRestorePassed": false,
    "nativeSourceValidationComplete": false,
    "beyvraCompartmentApproved": false
  }
}
