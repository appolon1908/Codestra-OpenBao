{
  "schemaVersion": 1,
  "status": "PREPARED_DISABLED",
  "runtimeApplyAuthorized": false,
  "engines": [
    {
      "path": "codestra/",
      "type": "kv-v2",
      "purpose": "versioned environment- and workload-scoped static secrets",
      "maxVersions": 10,
      "casRequired": true,
      "deleteVersionAfter": "2160h",
      "permanentDestroyRequiresProtectedApproval": true
    },
    {
      "path": "database/",
      "type": "database",
      "purpose": "compatibility-tested dynamic PostgreSQL credentials only",
      "defaultLeaseTtl": "15m",
      "maximumLeaseTtl": "1h",
      "enabledByDefault": false,
      "rootRotationRequiredBeforeProduction": true
    },
    {
      "path": "pki-codestra/",
      "type": "pki",
      "purpose": "approved private workload certificates beneath an offline root",
      "defaultLeafTtl": "24h",
      "maximumLeafTtl": "168h",
      "enabledByDefault": false,
      "allowAnyName": false,
      "allowIpSans": false
    },
    {
      "path": "transit-codestra/",
      "type": "transit",
      "purpose": "approved application encryption and signing use cases",
      "enabledByDefault": false,
      "exportableKeysAllowed": false
    }
  ],
  "prohibitedEngines": ["ssh"],
  "stableApplicationAccountsReplacedAutomatically": false
}
