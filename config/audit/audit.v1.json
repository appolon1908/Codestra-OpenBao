{
  "schemaVersion": 1,
  "status": "PREPARED_DISABLED",
  "runtimeApplyAuthorized": false,
  "requiredBeforeSecretUse": true,
  "device": {
    "type": "file",
    "path": "file-audit",
    "filePath": "/openbao/audit/openbao-audit.jsonl",
    "mode": "0600",
    "format": "json",
    "hmacAccessor": true,
    "logRaw": false,
    "failClosed": true
  },
  "shipping": {
    "agent": "alloy",
    "destination": "loki",
    "secretValuesAllowed": false,
    "requiredLabels": ["environment", "service", "node_id"]
