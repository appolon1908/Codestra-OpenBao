  "requiredApiControls": {
    "tenantAndRecordAuthorization": true,
    "roleAndServiceScopeAuthorization": true,
    "documentedVersionedContract": true,
    "auditEventsWithoutSecrets": true,
    "idempotencyForBookingsPaymentsMessagesAndCalls": true,
    "idempotencyScope": [
      "tenant_id",
      "principal_id",
      "operation",
      "idempotency_key"
    ],
    "sameKeyDifferentPayload": "reject-conflict",
    "sameKeySamePayload": "return-original-result",
    "signedProviderEvents": true,
    "eventDeduplicationAndReconciliation": true,
    "boundedTimeoutsRetriesAndRateLimits": true
  },
  "sharedComponents": {
    "Keycloak": "human login, MFA, sessions and machine identity; backends enforce record access",
    "Caddy + Kong": "TLS, versioned routing, identity integration and rate limits",
    "Middleware": "authorized adapters, stable identifiers, event routing, retries and reconciliation",
    "N8N": "authorized workflow orchestration through domain APIs",
    "OpenBao": "scoped provider and service secrets; no business records",
    "Klyrow + Telnexa": "tenant-scoped messaging, preferences and delivery status",
    "Odoo": "CRM and agreed accounting/support; no implicit ownership of product domain records",
    "Observability": "sanitized health, errors, latency, logs, traces and alerts"
  },
  "odooSynchronization": {
    "sourceRecordOwnerRequired": true,
    "sourceSystemAndRecordIdRequired": true,
    "sourceVersionRequired": true,
    "fieldMapRequiredBeforeActivation": true,
    "fieldMappings": [],
    "odooToProductWritableFields": [],
    "unmappedFieldUpdates": "deny",
    "loopPreventionAndEventDeduplicationRequired": true,
    "reconciliationRequired": true,
    "runtimeEnabled": false
  },
  "realtime": {
    "audioTransport": false,
    "tenantAuthorizedSubscriptions": true,
    "eventSourceRemainsAuthoritative": true
  }
