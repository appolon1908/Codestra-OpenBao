      "planRequired": true,
      "reviewRequired": true,
      "approvalRequired": true,
      "backupRequired": true,
      "readbackRequired": true,
      "rollbackArmedUntilReadback": true,
      "kernelExecutable": false,
      "mutatesOpenBao": true,
      "secretBearingAllowed": false
    },
    "TRANSIT": {
      "rank": 4,
      "description": "Transit mounts and non-exportable keys. Prepared but disabled; no executor is admitted yet.",
      "planRequired": true,
      "reviewRequired": true,
      "approvalRequired": true,
      "backupRequired": true,
      "readbackRequired": true,
      "rollbackArmedUntilReadback": true,
      "kernelExecutable": false,
      "mutatesOpenBao": true,
      "secretBearingAllowed": false
    },
    "ROTATION": {
      "rank": 4,
      "description": "Static secret rotation by reference. The kernel carries path, version and payload digest only; the value never enters the control plane.",
      "planRequired": true,
      "reviewRequired": true,
      "approvalRequired": true,
      "backupRequired": false,
      "readbackRequired": true,
      "rollbackArmedUntilReadback": true,
      "kernelExecutable": false,
      "mutatesOpenBao": true,
      "secretBearingAllowed": false
    },
    "CLUSTER": {
      "rank": 5,
      "description": "Raft topology, voters, audit devices, seal state and runtime image. Executed only by the protected runtime workflows, never by the kernel worker.",
      "planRequired": true,
      "reviewRequired": true,
      "approvalRequired": true,
      "backupRequired": true,
      "readbackRequired": true,
      "rollbackArmedUntilReadback": true,
      "kernelExecutable": false,
      "mutatesOpenBao": true,
      "secretBearingAllowed": false
    },
    "CUSTODY": {
      "rank": 6,
      "description": "Initialization, unseal, recovery shares and break-glass. Ceremony only; the kernel refuses every custody change.",
      "planRequired": true,
      "reviewRequired": true,
      "approvalRequired": true,
      "backupRequired": true,
      "readbackRequired": true,
      "rollbackArmedUntilReadback": true,
      "kernelExecutable": false,
      "mutatesOpenBao": true,
      "secretBearingAllowed": false
    },
    "DESTRUCTIVE": {
      "rank": 7,
      "description": "Delete, disable, destroy, snapshot restore over live state, plugin version overwrite, mount replacement. Refused by the kernel; separate protected approval and no automation.",
      "planRequired": true,
      "reviewRequired": true,
      "approvalRequired": true,
      "backupRequired": true,
      "readbackRequired": true,
      "rollbackArmedUntilReadback": true,
      "kernelExecutable": false,
      "mutatesOpenBao": true,
      "secretBearingAllowed": false
    },
    "PRODUCTION": {
      "rank": 8,
      "description": "Overlay applied to every mutating change whose environment is production. Requires the protected environment approval, release evidence, staging certification and a fresh pre-change backup.",
      "planRequired": true,
      "reviewRequired": true,
      "approvalRequired": true,
      "backupRequired": true,
      "readbackRequired": true,
      "rollbackArmedUntilReadback": true,
      "kernelExecutable": true,
      "mutatesOpenBao": true,
      "secretBearingAllowed": false
    }
  },
  "environmentOverlay": {
    "production": "PRODUCTION"
