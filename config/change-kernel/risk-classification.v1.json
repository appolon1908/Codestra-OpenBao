{
  "schemaVersion": 1,
  "status": "SOURCE_AUTHORITY",
  "runtimeApplyAuthorized": false,
  "description": "Canonical OpenBao V3 change risk classification. Every plan, review, safety, approval and runtime gate is derived from one class per change instead of scattered booleans.",
  "classes": {
    "READ_ONLY": {
      "rank": 0,
      "description": "Discovery, readback, drift detection and evidence reads. Never mutates OpenBao.",
      "planRequired": false,
      "reviewRequired": false,
      "approvalRequired": false,
      "backupRequired": false,
      "readbackRequired": false,
      "rollbackArmedUntilReadback": false,
      "kernelExecutable": true,
      "mutatesOpenBao": false,
      "secretBearingAllowed": false
    },
    "TENANT_METADATA": {
      "rank": 1,
      "description": "Management-plane metadata owned by the control plane (tenant, project, environment, consumer bindings). Recorded and validated by the kernel; no OpenBao mutation.",
      "planRequired": true,
      "reviewRequired": false,
      "approvalRequired": false,
      "backupRequired": false,
      "readbackRequired": false,
      "rollbackArmedUntilReadback": false,
      "kernelExecutable": false,
      "mutatesOpenBao": false,
      "secretBearingAllowed": false
    },
    "POLICY": {
      "rank": 2,
      "description": "ACL policy create or update from the generated policy index.",
      "planRequired": true,
      "reviewRequired": true,
      "approvalRequired": true,
      "backupRequired": false,
      "readbackRequired": true,
      "rollbackArmedUntilReadback": true,
      "kernelExecutable": true,
      "mutatesOpenBao": true,
      "secretBearingAllowed": false
    },
    "AUTH": {
      "rank": 3,
      "description": "Auth plugin registration, auth mount creation, mount configuration and CEL role create or update.",
      "planRequired": true,
      "reviewRequired": true,
      "approvalRequired": true,
      "backupRequired": false,
      "readbackRequired": true,
      "rollbackArmedUntilReadback": true,
      "kernelExecutable": true,
      "mutatesOpenBao": true,
      "secretBearingAllowed": false
    },
    "SECRET_ENGINE": {
      "rank": 3,
      "description": "KV v2 and database engine mounts and their non-secret configuration.",
      "planRequired": true,
      "reviewRequired": true,
      "approvalRequired": true,
      "backupRequired": false,
      "readbackRequired": true,
      "rollbackArmedUntilReadback": true,
      "kernelExecutable": true,
      "mutatesOpenBao": true,
      "secretBearingAllowed": false
    },
    "PKI": {
      "rank": 4,
