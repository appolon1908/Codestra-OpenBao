{
  "schema": "kyyow.platform-component.v1",
  "repository": "appolon1908-hue/Codestra-OpenBao",
  "component": "openbao",
  "authority": "secrets",
  "exposure": "private-admin",
  "native_ports": [
    8200
  ],
  "inputs": [
    "keycloak:oidc",
    "workload-identity"
  ],
  "outputs": [
    "short-lived-secrets"
  ],
  "controls": [
    "stores credentials, signing keys, certificates, and leases only",
    "scraped records, HTML, companies, contacts, analytics, logs, and traces are prohibited",
    "policies are workload- and tenant-scoped with default denial",
    "root tokens are not used by applications and the native API is never broadly public"
  ],
  "identity": {
    "authority": "appolon1908-hue/Keycloak",
    "workload_identity_required": true,
    "anonymous_admin_access": false
  },
  "secrets": {
    "authority": "appolon1908-hue/Codestra-OpenBao",
    "secrets_in_git": false,
    "environment_plaintext_secrets": false
  },
  "operations": {
    "middleware_is_sole_odoo_writer": true,
    "grafana_read_only": true,
    "superset_read_only": true
  },
  "activation": {
    "source_contract_complete": true,
    "runtime_evidence_complete": false,
    "production_activation_authorized": false
  }
}

