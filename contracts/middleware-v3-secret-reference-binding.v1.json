            "codestra/staging/middleware/api/"
          ],
          "production": [
            "codestra/production/middleware/api/"
          ]
        },
        "operations": [
          "read"
        ]
      },
      {
        "client_exact": "middleware-worker",
        "role_exact_by_environment": {
          "staging": "middleware-worker-staging",
          "production": "middleware-worker-production"
        },
        "policy_exact_by_environment": {
          "staging": "workload-middleware-worker-staging",
          "production": "workload-middleware-worker-production"
        },
        "approved_path_prefixes_by_environment": {
          "staging": [
            "codestra/staging/middleware/worker/email/",
            "codestra/staging/middleware/worker/sms/",
            "codestra/staging/middleware/worker/social/",
            "codestra/staging/middleware/worker/advertising/",
            "codestra/staging/middleware/worker/ai/",
            "codestra/staging/middleware/worker/telephony/",
            "codestra/staging/middleware/worker/crawler/"
          ],
          "production": [
            "codestra/production/middleware/worker/email/",
            "codestra/production/middleware/worker/sms/",
            "codestra/production/middleware/worker/social/",
            "codestra/production/middleware/worker/advertising/",
            "codestra/production/middleware/worker/ai/",
            "codestra/production/middleware/worker/telephony/",
            "codestra/production/middleware/worker/crawler/"
          ]
        },
        "operations": [
          "read"
        ]
      }
    ]
  },
  "negative_tests": {
    "executor": "tests/security/test_middleware_v3_workload_negative.py (static evaluation of the declared binding and of the generated CEL role literals; no OpenBao runtime)",
    "cases": {
      "wrong_issuer": "DENY",
      "wrong_audience": "DENY",
      "wrong_client": "DENY",
      "wrong_role": "DENY",
      "expired_token": "DENY",
      "tampered_token": "DENY",
      "foreign_service": "DENY",
      "staging_to_production": "DENY",
      "unapproved_path": "DENY",
      "replayed_jti": "DENY",
      "own_identity_own_environment_approved_path": "ALLOW"
    },
    "live_reproduction": "scripts/integration_test_jti_plugin.sh and scripts/certify_staging_identity.py (staging only; production is never exercised by Lane E)"
  },
  "kv_v2_access": {
    "engine_path": "codestra/",
