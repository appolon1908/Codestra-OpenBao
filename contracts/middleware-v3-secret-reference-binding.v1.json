{
  "schema_version": "1.0",
  "contract_id": "middleware-v3-secret-reference-binding",
  "lane": "E",
  "status": "PREPARED_DISABLED",
  "activation_enabled": false,
  "provider_effects_enabled": false,
  "purpose": "Binds the Middleware V3 command kernel to OpenBao as the only secret authority: Middleware stores secret references and metadata, never values; every V3 workload read is an exact Keycloak-JWT identity bound to one issuer, one audience, one client, one role, one environment policy and approved paths only.",
  "middleware": {
    "repository": "appolon1908-hue/Middleware-",
    "prep_base_sha": "22d023a9c65b0789a0f7ee6c28548753521a9eff",
    "v3_final_sha": "PENDING",
    "repin_required_after_v3_merge": true,
    "v3_candidate_observed": {
      "branch": "mission/middleware-v3-command-kernel-20260919",
      "sha": "1acb2ae",
      "authority": "informational only; unmerged, owned by the Middleware V3 session"
    },
    "vendored_schema_path": "contracts/secrets/secret-reference.v1.schema.json",
    "vendored_schema_pin_path": "contracts/secrets/secret-reference.v1.schema.sha256",
    "vendored_schema_canonical_sha256_at_prep_base": "8762a999da747a9450d73dc876718a3f70a3fb47fd1e065689cdf2357849a665",
    "reference_model_module": "app/secret_reference.py",
    "byte_identical_to_authority_at_prep_base": true
  },
  "runtimeApplyAuthorized": false,
  "production_initialize_or_unseal_authorized": false,
  "production_rotation_authorized": false,
  "secret_reference_contract": {
    "authority_schema": "contracts/secret-reference.v1.schema.json",
    "authority_schema_canonical_sha256": "8762a999da747a9450d73dc876718a3f70a3fb47fd1e065689cdf2357849a665",
    "canonicalization": "sha256 over json.dumps(document, sort_keys=True, separators=(',', ':'))",
    "provider": "openbao",
    "logical_metadata_fields": {
      "secret_id": "secret_ref (codestra/<environment>/<workload>/<name>) and reference_uri (openbao://<secret_ref>)",
      "provider": "provider (constant 'openbao')",
      "environment": "environment (development|test|staging|production); must equal the secret_ref environment segment",
      "version_or_reference": "version (KV v2 version, integer >= 1, null = current) and reference_uri",
      "lease_metadata": "lease_metadata {lease_id_hash sha256:<hex>, ttl_seconds, renewable, issued_at, expires_at}",
      "rotation_metadata": "rotation_status (unknown|current|rotation_due|rotating|revoked), last_reconciled_at, last_reconciliation_status (unknown|readable|denied|missing|openbao_unavailable)",
      "identity_metadata": "service_id, workload_identity, secret_owner, consumer_repository, secret_class"
    },
    "forbidden_keys": [
      "value",
      "password",
      "token",
      "private_key",
      "client_secret",
      "secret",
      "secret_value",
      "unseal_key",
      "recovery_key",
      "root_token"
    ],
    "secret_classes": [
      "database_credentials",
      "cache_credentials",
      "oidc_client_secret",
      "smtp_credentials",
      "webhook_signing_secret",
      "provider_credentials",
      "pki_material",
      "api_token",
      "object_storage_credentials",
      "scrape_credentials",
      "encryption_key"
    ],
    "resolved_values_must_never_enter": [
      "command payload",
      "outbox",
      "ledger",
      "audit",
      "logs",
      "metrics",
      "traces",
      "incident timeline",
      "reconciliation records",
      "API responses",
      "Git",
      "container images",
      "environment variables"
    ],
    "resolution_point": "OpenBao agent renders the value to a 0400 runtime file inside the consuming process boundary only (secretInjection in config/workload-secret-authority.v1.json); Middleware reads the file at use time and holds only the reference plus metadata.",
    "fail_closed_resolution": {
      "missing_secret_fails_startup": true,
      "denied_read_marks_reference": "last_reconciliation_status=denied and the dependent capability stays disabled",
      "openbao_unavailable_marks_reference": "last_reconciliation_status=openbao_unavailable; no cached value is ever served from Middleware state",
      "never_fallback_to_environment_variables": true,
      "never_fallback_to_git_materialization": true
    }
  },
  "workload_authentication_target": {
    "method": "keycloak-jwt (auth/jwt-codestra, one CEL role per identity per environment)",
    "source_of_truth": "config/workload-secret-authority.v1.json + config/auth/keycloak-jwt.v1.json -> openbao/auth/jwt-roles.v1.json (generated)",
    "audience_exact": "openbao",
    "issuer_exact_by_environment": {
      "development": "https://auth-staging.codestra.co/realms/codestra",
      "test": "https://auth-staging.codestra.co/realms/codestra",
      "staging": "https://auth-staging.codestra.co/realms/codestra",
      "production": "https://auth.codestra.co/realms/codestra"
    },
    "required_claims": [
      "iss",
      "sub",
      "aud",
      "azp",
      "iat",
      "exp",
      "jti",
      "codestra_environment"
    ],
    "maximum_jwt_lifetime_seconds": 300,
    "clock_skew_leeway_seconds": 30,
    "jti_replay_denied": true,
    "foreign_issuer_accepted": false,
    "wildcard_client_matching_allowed": false,
    "middleware_v3_identities": [
      {
        "client_exact": "middleware-api",
        "role_exact_by_environment": {
          "staging": "middleware-api-staging",
          "production": "middleware-api-production"
        },
        "policy_exact_by_environment": {
          "staging": "workload-middleware-api-staging",
