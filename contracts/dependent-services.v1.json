{
  "schema_version": "1.2",
  "authority": "ingtrader21-spec/Codestra-OpenBao",
  "environment": "production",
  "canonical_endpoint": "https://bao.codestra.media",
  "canonical_framework": {
    "deployment": "deploy/compose/compose.yaml",
    "workload_authority": "config/workload-secret-authority.v1.json",
    "keycloak_jwt": "config/auth/keycloak-jwt.v1.json",
    "jwt_roles": "openbao/auth/jwt-roles.v1.json",
    "audit": "config/audit/audit.v1.json",
    "secret_engines": "config/secrets/engines.v1.json",
    "initialize": "scripts/initialize.sh",
    "apply": "scripts/apply_saved_plan.sh",
    "verify": "scripts/verify.sh",
    "secret_references": "config/secret-references.v1.json",
    "secret_reference_schema": "contracts/secret-reference.v1.schema.json"
  },
  "authority_binding": {
    "source": "config/workload-secret-authority.v1.json",
    "source_blob_sha": "1985d3c4948c961a03ff6624bc03b41b70a06419",
    "derivation": "Exact production serviceIdentity and pathPrefixes; no parent-prefix broadening.",
    "default_policy": "deny",
    "runtime_binding_authorized": false
  },
  "consumers": [
    {
      "repo": "ingtrader21-spec/Middleware-",
      "access": [
        {
          "identity": "middleware-api",
          "prefixes": [
            "codestra/production/middleware/api/"
          ]
        },
        {
          "identity": "middleware-worker",
          "prefixes": [
            "codestra/production/middleware/worker/email/",
            "codestra/production/middleware/worker/sms/",
            "codestra/production/middleware/worker/social/",
            "codestra/production/middleware/worker/advertising/",
            "codestra/production/middleware/worker/ai/",
            "codestra/production/middleware/worker/telephony/",
            "codestra/production/middleware/worker/crawler/"
          ]
        }
      ]
    },
    {
      "repo": "ingtrader21-spec/Odoo",
      "access": [
        {
          "identity": "odoo-integration",
          "prefixes": [
            "codestra/production/odoo/integration/"
          ]
        }
      ],
      "constraint": "credentials only; no business data"
    },
    {
      "repo": "ingtrader21-spec/klyrow.com",
      "access": [
        {
          "identity": "klyrow-email-adapter",
          "prefixes": [
            "codestra/production/middleware/worker/email/klyrow/"
          ]
        }
      ],
      "constraint": "live email delivery remains separately gated"
    },
    {
      "repo": "ingtrader21-spec/telnexa",
      "access": [
        {
          "identity": "telnexa-sms-adapter",
          "prefixes": [
            "codestra/production/middleware/worker/sms/telnexa/"
          ]
        }
      ],
      "constraint": "live SMS remains separately gated"
    },
    {
      "repo": "ingtrader21-spec/Vicidialer-Codestra",
      "access": [
        {
          "identity": "vicidial-adapter",
          "prefixes": [
            "codestra/production/middleware/worker/telephony/vicidial/"
          ]
        }
      ],
      "constraint": "production dialing remains separately gated"
    },
    {
      "repo": "ingtrader21-spec/Codestra-Prometheus",
      "access": [
        {
          "identity": "prometheus-openbao",
          "prefixes": [
            "codestra/production/observability/openbao/metrics-client/",
            "codestra/production/observability/prometheus/scrape-credentials/"
          ]
        }
      ],
      "constraint": "private OpenBao metrics client material and reviewed scrape credentials only; sys/metrics read is the only system capability"
    },
    {
      "repo": "ingtrader21-spec/Codestra-Grafana-",
      "access": [
        {
          "identity": "grafana-runtime",
          "prefixes": [
            "codestra/production/observability/grafana/"
          ]
        }
      ],
      "constraint": "datasource, Middleware read-token and OIDC client secret only; dashboards never display a secret"
    },
    {
      "repo": "ingtrader21-spec/Codestra-Alertmanager",
      "access": [
        {
          "identity": "alertmanager",
          "prefixes": [
            "codestra/production/observability/alertmanager/"
          ]
        }
      ],
      "constraint": "Middleware webhook bearer only; incidents remain in Middleware"
    },
    {
      "repo": "ingtrader21-spec/Codestra-Alloy",
      "access": [
        {
          "identity": "alloy-collector",
          "prefixes": [
            "codestra/production/observability/alloy/"
          ]
        }
      ],
      "constraint": "push and gateway credentials only; redaction runs before export"
    },
    {
      "repo": "ingtrader21-spec/Codestra-Telemetry",
      "access": [
        {
          "identity": "otel-gateway",
          "prefixes": [
            "codestra/production/observability/otel-gateway/"
          ]
        }
      ],
      "constraint": "receiver and exporter credentials only"
    },
    {
      "repo": "ingtrader21-spec/Codestra-Loki",
      "access": [
        {
          "identity": "loki-runtime",
          "prefixes": [
            "codestra/production/observability/loki/"
          ]
        }
      ],
      "constraint": "object-storage credentials only"
    },
    {
      "repo": "ingtrader21-spec/Codestra-Tempo",
      "access": [
        {
          "identity": "tempo-runtime",
          "prefixes": [
            "codestra/production/observability/tempo/"
          ]
        }
      ],
      "constraint": "object-storage credentials only"
    },
    {
      "repo": "ingtrader21-spec/Codestra-Redis-Exporter",
      "access": [
        {
          "identity": "redis-exporter",
          "prefixes": [
            "codestra/production/observability/exporters/redis/"
          ]
        }
      ],
      "constraint": "monitoring-only Redis ACL user"
    },
    {
      "repo": "ingtrader21-spec/Codestra-Postgres-Exporter",
      "access": [
        {
          "identity": "postgres-exporter",
          "prefixes": [
            "codestra/production/observability/exporters/postgres/"
          ]
        }
      ],
      "constraint": "pg_monitor role only; no application data access"
    },
    {
      "repo": "ingtrader21-spec/Superset",
      "access": [
        {
          "identity": "superset-analytics",
          "prefixes": [
            "codestra/production/analytics/superset/"
          ]
        }
      ],
      "constraint": "read-only analytics identity; never Prometheus, Loki, Tempo or OpenBao administration"
    }
  ],
  "integrations_without_openbao_workload_identity": [
    {
      "repo": "ingtrader21-spec/Keycloak",
      "role": "JWT issuer and confidential-client authority; not an admitted OpenBao secret-reading workload"
    },
    {
      "repo": "ingtrader21-spec/Codestra-Node-Exporter",
      "role": "credential-free host exporter on a private listener; no OpenBao role"
    },
    {
      "repo": "ingtrader21-spec/Codestra-cAdvisor",
      "role": "credential-free container exporter on a private listener; no OpenBao role"
    },
    {
      "repo": "ingtrader21-spec/Codestra-Blackbox-Exporter",
      "role": "safe GET/HEAD/DNS/TCP/TLS prober; holds no credentials; no OpenBao role"
    },
    {
      "repo": "ingtrader21-spec/Caddy",
      "role": "TLS edge; certificate automation is native; no OpenBao role"
    }
  ],
  "required_runtime_gates": {
    "exact_scanned_image": true,
    "sbom_and_provenance": true,
    "three_voting_nodes": true,
    "pgp_offline_custody_3_of_5": true,
    "native_ports_private": true,
    "mtls": true,
    "keycloak_jwt_exact_claims": true,
    "audit_before_secret_use": true,
    "saved_plan_zero_destroy": true,
    "runtime_apply_authorized": true
  },
  "invariants": {
    "secret_values_in_git": false,
    "browser_provider_secrets": false,
    "cross_environment_reads": false,
    "observability_application_provider_credentials": false,
    "odoo_business_data_in_openbao": false,
    "native_port_public": false,
    "parent_prefix_broadening": false,
    "unadmitted_workload_identities": false
  },
  "decisions": [
    {
      "id": "R7-2026-09-16-monitoring-identities-admitted",
      "supersedes": "schema 1.1 note that Grafana, Superset and Alertmanager had no production OpenBao role",
      "decision": "Grafana, Alertmanager, Alloy, the OTel gateway, Loki, Tempo, the Redis and Postgres exporters and Superset are admitted as exact-prefix, read-only, staging/production workload identities so that no monitoring credential lives in Git. Node Exporter, cAdvisor and Blackbox remain credential-free.",
      "runtime_binding_authorized": false
    }
  ]
}
